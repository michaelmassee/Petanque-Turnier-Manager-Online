{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "petanque-turnier-manager-online",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "durable_objects": { "bindings": [
    { "name": "REGISTRATION_OPENING_SCHEDULER", "class_name": "RegistrationOpeningScheduler" },
    { "name": "TOURNAMENT_LIVE_HUB", "class_name": "TournamentLiveHub" }
  ] },
  "migrations": [
    { "tag": "registration-opening-v1", "new_sqlite_classes": ["RegistrationOpeningScheduler"] },
    { "tag": "tournament-live-hub-v1", "new_sqlite_classes": ["TournamentLiveHub"] }
  ],
  "ratelimits": [
    { "name": "PLAYER_DETAILS_ACCOUNT_LIMIT", "namespace_id": "2003", "simple": { "limit": 6, "period": 60 } },
    { "name": "PLAYER_DETAILS_IP_LIMIT", "namespace_id": "2004", "simple": { "limit": 30, "period": 60 } }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "ptmonline.org", "custom_domain": true },
    { "pattern": "www.ptmonline.org", "custom_domain": true }
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "petanque-turnier-manager-online"
    }
  ],
  "vars": {
    "MAIL_FROM": "noreply@ptmonline.org",
    "STRATO_MAIL_FROM": "ptmonline@bclinden.de",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEtxoT1UMgPGYH14",
    "CF_ACCOUNT_ID": "f140eb5685d383d686a5501a02a22d65"
  },
  "triggers": {
    "crons": ["0 1 * * *", "0 * * * *"]
  },
  "queues": {
    "producers": [
      { "binding": "MAIL_QUEUE", "queue": "ptm-mail-queue" }
    ],
    "consumers": [
      {
        "queue": "ptm-mail-queue",
        "max_batch_size": 3,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "ptm-mail-dlq"
      }
    ]
  }
}
