{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "petanque-turnier-manager-online",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "ptmonline.org", "custom_domain": true },
    { "pattern": "www.ptmonline.org", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "petanque-turnier-manager-online"
    }
  ],
  "vars": {
    "MAIL_FROM": "noreply@ptmonline.org",
    "STRATO_MAIL_FROM": "ptmonline@bclinden.de",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEtxoT1UMgPGYH14"
  },
  "triggers": {
    "crons": ["0 1 * * *"]
  },
  "queues": {
    "producers": [
      { "binding": "MAIL_QUEUE", "queue": "ptm-mail-queue" }
    ],
    "consumers": [
      {
        "queue": "ptm-mail-queue",
        "max_batch_size": 3,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "ptm-mail-dlq"
      }
    ]
  }
}
