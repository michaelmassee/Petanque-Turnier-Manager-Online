{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "petanque-turnier-manager-online",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-31",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "petanque-turnier-manager-online"
    }
  ]
}
